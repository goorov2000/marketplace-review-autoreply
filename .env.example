# Витринная копия: все значения пустые. Скопируйте файл в .env и заполните своими ключами.
# WB-скрипт (wb/wb_reviews_reply.py) читает .env через python-dotenv, поиск идёт вверх от wb/.
# Ozon-скрипт (ozon/ozon_reviews_reply.py) читает только переменные окружения процесса
# (на Render они задаются в ozon/render.yaml), поэтому локально их нужно экспортировать.
# Закомментированные переменные необязательны; после «=» указано значение по умолчанию из кода.
# Оставлять их раскомментированными с пустым значением нельзя: код делает int()/использует строку как есть.

# --- Общие для обоих сервисов ---
OPENAI_API_KEY=
# По умолчанию в коде: gpt-4o-mini (wb), gpt-5.4-mini (ozon)
#OPENAI_MODEL=
# 1 — ничего не публиковать, только показать ответы (значение по умолчанию в обоих скриптах)
DRY_RUN=1

# --- Wildberries: wb/wb_reviews_reply.py ---
# Токен API отзывов WB, без префикса Bearer
WB_TOKEN=
# Необязательно: значение для заголовка OpenAI-Project (пустое — заголовок не отправляется)
OPENAI_PROJECT=
#OPENAI_MAXTOKENS=220
#MAX_COUNT=50
#CLASSIFICATION_RULES_PATH=app/config/classification_rules.json
#SCENARIOS_PATH=app/config/scenarios.json
#SYSTEM_PROMPT_PATH=app/prompts/system_ru.txt
#USER_TEMPLATE_PATH=app/prompts/user_template.txt

# --- Ozon: ozon/ozon_reviews_reply.py ---
OZON_CLIENT_ID=
OZON_API_KEY=
#PROMPT_PATH=prompt_ozon_ru.txt
#SKIP_EMPTY=1
#ONLY_UNANSWERED=1
#MARK_EMPTY_AS_PROCESSED=0
#EMPTY_REPLY_LEVEL=soft
#PAGE_LIMIT=100
#MAX_PAGES=10
#LOG_LEVEL=INFO
#LOG_SHOW_LLM=1
#LOG_PII_MASK=1
#LOG_MAX_LLM=100
